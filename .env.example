NODE_ENV=production
PORT=8080

# Only needed if the sqlite file should live somewhere other than
# ./data/server_watch.db
# SQLITE_PATH=

LOG_LEVEL=info

# Only set to true if this instance is genuinely served over HTTPS (directly
# or via a reverse proxy) -- see src/lib/config.js's comment on why this
# defaults off.
# SESSION_COOKIE_SECURE=true
